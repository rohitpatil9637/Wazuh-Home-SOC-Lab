<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>

<group name="local,lab,">
  <!-- Rule 1: 5+ failed SSH logins from one IP within 2 minutes -->
  <rule id="100010" level="10" frequency="5" timeframe="120">
    <if_matched_group>authentication_failed</if_matched_group>
    <same_source_ip />
    <description>LAB: SSH brute force - 5+ failed logins from same IP in 2 min</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- Rule 2: a new local user was created -->
  <rule id="100011" level="12">
    <if_sid>5902</if_sid>
    <description>LAB: New local user account created on a monitored host</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
  </rule>

  <!-- Rule 3: the SSH server config file was changed -->
  <rule id="100012" level="12">
    <if_sid>550</if_sid>
    <field name="file">/etc/ssh/sshd_config</field>
    <description>LAB: SSH server configuration file modified</description>
  </rule>

</group>
